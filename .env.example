# ═══════════════════════════════════════════════════════════════
# .env.example — Copy to .env and fill in your values.
#
# NEVER commit .env to git. It is already in .gitignore.
# NEVER share this file with your actual values filled in.
# ═══════════════════════════════════════════════════════════════

# ── Anthropic (Claude API) ────────────────────────────────────
# Get from: https://console.anthropic.com → API Keys → Create key
# Required for: job scoring (score_jobs.py), application prep (generate_covers.py,
#   generate_summaries.py), and email classification (gmail_backfill.py)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# ── Apify (LinkedIn job scraper) ──────────────────────────────
# Get from: https://console.apify.com → Settings → Integrations → API token
# Required for: job scouting (run_scout.py)
# Free tier: $5/month credit (~6 full intl runs/month at zero cost)
APIFY_TOKEN=YOUR_APIFY_TOKEN

# Apify actor for LinkedIn scraping — leave as-is unless you switch actors
APIFY_LINKEDIN_ACTOR=bebity/linkedin-jobs-scraper

# ── Email (IMAP) ──────────────────────────────────────────────
# Used by gmail_backfill.py to classify job application emails via IMAP.
# Default: Yahoo Mail (imap.mail.yahoo.com). Also works with Gmail, Outlook.
#
# For Yahoo: Create an App Password at https://security.yahoo.com → Account security
#   → Generate app password. Use that password (not your main Yahoo password).
# For Gmail: Enable IMAP in Gmail settings + create App Password at myaccount.google.com
#   → Security → 2-Step Verification → App passwords
YAHOO_EMAIL=your.email@yahoo.com
YAHOO_APP_PASSWORD=your_16_char_app_password

# ── Google Sheets ─────────────────────────────────────────────
# Create a Google Spreadsheet, then extract the ID from the URL:
#   https://docs.google.com/spreadsheets/d/[THIS_IS_THE_ID]/edit
# Required for: sheets_sync.py (bidirectional sync)
# The service account JSON goes in: data/google_service_account.json (gitignored)
# Setup guide: templates/google_sheets_setup.md
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID

# ── GitHub ────────────────────────────────────────────────────
# Personal access token for git_sync.py and optional CI monitoring.
# Create at: https://github.com/settings/tokens → Generate new token (classic)
# Scopes needed: repo (full repository access for push)
GITHUB_TOKEN=YOUR_GITHUB_TOKEN

# GitHub repository for CI monitoring in monitor_scout.py (optional).
# Format: username/repository-name (e.g. johndoe/my-job-automation)
# Leave blank to disable CI run monitoring.
GITHUB_REPO=YOUR_USERNAME/YOUR_REPO_NAME
